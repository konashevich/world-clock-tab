{
  "manifest_version": 3,
  "name": "World Clock Tab",
  "short_name": "World Clock Tab",
  "version": "1.1.12",
  "description": "New Tab vertical city columns with photos. Toolbar analog clock for the selected city.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "World Clock Tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://en.wikipedia.org/*",
    "https://upload.wikimedia.org/*",
    "https://thumb.wikimedia.org/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://upload.wikimedia.org https://thumb.wikimedia.org data: blob:; connect-src 'self' https://en.wikipedia.org;"
  }
}
